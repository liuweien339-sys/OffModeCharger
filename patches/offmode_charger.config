# OffModeCharger - defconfig fragment
#
# Usage (after .config has been generated from the patched tree):
#   make ARCH=arm64 O=out gauguin_defconfig
#   scripts/kconfig/merge_config.sh -m out/.config /path/to/offmode_charger.config
#   make ARCH=arm64 O=out olddefconfig
#
# CONFIG_FB                   fbdev core, provides registered_fb[]
# CONFIG_DRM_FBDEV_EMULATION  fbdev compat layer of the msm/techpack DRM driver
#                             (selects FB, FB_SYS_FILLRECT/COPYAREA/IMAGEBLIT)
#
# Logging to /data/adb/offmode_charger/charger.log is always enabled;
# verbose per-poll lines are opt-in (default off):
#   CONFIG_OFFMODE_CHARGER_DEBUG=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_OFFMODE_CHARGER=y
