diff --git a/drivers/power/supply/offmode_charger/offmode_charger_core.c b/drivers/power/supply/offmode_charger/offmode_charger_core.c
new file mode 100644
index 0000000..2a2e876
--- /dev/null
+++ b/drivers/power/supply/offmode_charger/offmode_charger_core.c
@@ -0,0 +1,783 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Kernel level off-mode (charger) UI.
+ *
+ * Replaces the user space "charged"/charger service for the off-mode charging
+ * screen: when the bootloader boots with androidboot.mode=charger the kernel
+ * keeps the display alive, watches the charger + fuel gauge, powers off when
+ * the cable is pulled and continues to boot when the power key is held.
+ *
+ * Copyright (C) 2026
+ */
+
+#define pr_fmt(fmt)	"offmode_charger: " fmt
+
+#include <linux/atomic.h>
+#include <linux/console.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/power_supply.h>
+#include <linux/reboot.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include <linux/offmode_charger.h>
+
+#include "offmode_charger_internal.h"
+
+/* Wait this long for the charger/fuel gauge drivers to show up. */
+#define LPM_PSY_WAIT_MS		10000
+/* Give up and boot normally if the cable never shows up as online. */
+#define LPM_NO_CHARGER_BOOT_MS	8000
+/* Consecutive "not online" polls after which we power off. */
+#define LPM_OFF_TICKS		3
+/* Poll period, also the animation period. */
+#define LPM_ANIM_MS		600
+/* How long the power key has to be held to boot normally. */
+#define LPM_BOOT_HOLD_MS	1500
+
+extern char *saved_command_line;
+
+/*
+ * Battery supply name.  The lookup also tries bms/batt and finally scans
+ * the power_supply class for POWER_SUPPLY_TYPE_BATTERY, so this does not
+ * need a module parameter.
+ */
+#define LPM_BATTERY_PSY_NAME	"battery"
+
+/*
+ * Xiaomi-style charge curve: keep the full current up to 80%, taper it
+ * linearly down to 35% at 95% and start derating 3 C below LPM_TEMP_LIMIT.
+ * At charge_limit the current drops to LPM_MIN_CURRENT_UA, i.e. charging stops.
+ */
+#define LPM_FAST_UNTIL	80
+#define LPM_TAPER_END	95
+#define LPM_TAPER_PCT	35
+#define LPM_WARM_DELTA	3
+
+static int charge_limit = 100;
+module_param(charge_limit, int, 0644);
+MODULE_PARM_DESC(charge_limit,
+		 "Stop charging at this capacity in percent (100 disables)");
+
+/* fixed policy knobs of the Xiaomi-style curve */
+#define LPM_TEMP_LIMIT		45	/* pause charging above this (C) */
+#define LPM_MIN_CURRENT_UA	100000	/* "stopped" charge current (uA) */
+
+struct lpm_ctx {
+	struct power_supply *batt;
+	struct power_supply *usb;
+};
+
+static DECLARE_WAIT_QUEUE_HEAD(lpm_wait);
+static struct delayed_work lpm_boot_work;
+static bool lpm_boot_requested;
+static bool lpm_running;
+
+/* ------------------------------------------------------------------ */
+/* boot mode detection							*/
+/* ------------------------------------------------------------------ */
+
+static bool lpm_cmdline_is_charger(void)
+{
+	if (!saved_command_line)
+		return false;
+
+	if (strstr(saved_command_line, "androidboot.mode=charger"))
+		return true;
+
+	/*
+	 * A few bootloaders only pass the boolean form; harmless to accept,
+	 * it is never rewritten by lpm_rewrite_cmdline().
+	 */
+	return strstr(saved_command_line, "androidboot.charger=1") != NULL;
+}
+
+bool offmode_charger_boot_mode(void)
+{
+	if (lpm_cmdline_is_charger()) {
+		pclog("androidboot.mode=charger found in cmdline");
+		return true;
+	}
+
+	pclog("not a charger boot (no androidboot.mode=charger)");
+
+	return false;
+}
+
+/*
+ * Android's init decides between "charger" and a normal boot by looking at
+ * /proc/cmdline.  When we hand over to init after the user held the power key
+ * we must make sure init does not start the user space charger service again,
+ * but the command line is one big string and inserting a '\0' would cut off
+ * everything behind it.  "normal " is exactly as long as "charger", so just
+ * overwrite the value and keep the rest of the command line intact.
+ */
+static void lpm_rewrite_cmdline(void)
+{
+	static const char from[] = "androidboot.mode=charger";
+	static const char to[] = "androidboot.mode=normal ";
+	char *p;
+
+	if (!saved_command_line)
+		return;
+
+	p = strstr(saved_command_line, from);
+	if (!p)
+		return;
+
+	if (strlen(from) != strlen(to))
+		return;
+
+	memcpy(p, to, strlen(to));
+	pclog("cmdline: charger mode cleared, continuing with a normal boot");
+}
+
+/* ------------------------------------------------------------------ */
+/* power supply helpers							*/
+/* ------------------------------------------------------------------ */
+
+static bool lpm_psy_is_charger(int type)
+{
+	switch (type) {
+	case POWER_SUPPLY_TYPE_USB:
+	case POWER_SUPPLY_TYPE_USB_DCP:
+	case POWER_SUPPLY_TYPE_USB_CDP:
+	case POWER_SUPPLY_TYPE_USB_ACA:
+	case POWER_SUPPLY_TYPE_USB_TYPE_C:
+	case POWER_SUPPLY_TYPE_USB_PD:
+	case POWER_SUPPLY_TYPE_USB_PD_DRP:
+	case POWER_SUPPLY_TYPE_MAINS:
+		return true;
+	default:
+		return false;
+	}
+}
+
+struct lpm_psy_lookup {
+	const char *name;
+	bool charger;
+	char found[32];
+};
+
+static int lpm_psy_lookup_cb(struct device *dev, void *data)
+{
+	struct lpm_psy_lookup *lk = data;
+	struct power_supply *psy = dev_get_drvdata(dev);
+
+	if (!psy || !psy->desc || !psy->desc->name)
+		return 0;
+
+	if (lk->name && !strcmp(psy->desc->name, lk->name)) {
+		strlcpy(lk->found, psy->desc->name, sizeof(lk->found));
+		return 1;
+	}
+
+	if (!lk->name) {
+		if (lk->charger ? lpm_psy_is_charger(psy->desc->type) :
+				  psy->desc->type == POWER_SUPPLY_TYPE_BATTERY) {
+			strlcpy(lk->found, psy->desc->name, sizeof(lk->found));
+			return 1;
+		}
+	}
+
+	return 0;
+}
+
+static struct power_supply *lpm_get_psy(const char *name, bool charger)
+{
+	struct lpm_psy_lookup lk;
+	struct power_supply *psy;
+
+	if (name) {
+		psy = power_supply_get_by_name(name);
+		if (psy) {
+			pcdbg("power supply \"%s\" found by name", name);
+			return psy;
+		}
+	}
+
+	memset(&lk, 0, sizeof(lk));
+	lk.charger = charger;
+
+	if (power_supply_class &&
+	    class_for_each_device(power_supply_class, NULL, &lk,
+				  lpm_psy_lookup_cb) == 1 && lk.found[0]) {
+		pcdbg("power supply \"%s\" found by %s", lk.found,
+		      charger ? "charger type" : "battery type");
+		return power_supply_get_by_name(lk.found);
+	}
+
+	return NULL;
+}
+
+static struct power_supply *lpm_get_charger_psy(void)
+{
+	static const char * const names[] = {
+		"usb", "main", "charger", "ac", "pc_port", "wireless",
+	};
+	struct power_supply *psy;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		psy = power_supply_get_by_name(names[i]);
+		if (psy) {
+			pcdbg("charger supply \"%s\" found", names[i]);
+			return psy;
+		}
+	}
+
+	return lpm_get_psy(NULL, true);
+}
+
+static struct power_supply *lpm_get_battery_psy(void)
+{
+	static const char * const names[] = { "battery", "bms", "batt" };
+	struct power_supply *psy;
+	int i;
+
+	psy = lpm_get_psy(LPM_BATTERY_PSY_NAME, false);
+	if (psy)
+		return psy;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (!strcmp(names[i], LPM_BATTERY_PSY_NAME))
+			continue;
+
+		psy = power_supply_get_by_name(names[i]);
+		if (psy) {
+			pcdbg("battery supply \"%s\" found", names[i]);
+			return psy;
+		}
+	}
+
+	return lpm_get_psy(NULL, false);
+}
+
+static int lpm_wait_supplies(struct lpm_ctx *ctx)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(LPM_PSY_WAIT_MS);
+
+	for (;;) {
+		if (!ctx->batt)
+			ctx->batt = lpm_get_battery_psy();
+		if (!ctx->usb)
+			ctx->usb = lpm_get_charger_psy();
+
+		if (ctx->batt) {
+			pclog("supplies ready: battery found");
+			return 0;
+		}
+
+		if (time_after(jiffies, timeout)) {
+			pcwarn("timed out waiting for the battery supply");
+			return -ENODEV;
+		}
+
+		msleep(100);
+	}
+}
+
+static void lpm_read_state(struct lpm_ctx *ctx, struct offmode_charger_state *st)
+{
+	union power_supply_propval v;
+
+	st->capacity = -1;
+	st->status = POWER_SUPPLY_STATUS_UNKNOWN;
+	st->temp = S32_MIN;
+	st->present = -1;
+	st->online = 0;
+	st->power_uw = 0;
+	st->charge_ms = 0;
+	st->avg_power_uw = 0;
+
+	if (ctx->batt) {
+		if (!power_supply_get_property(ctx->batt,
+					       POWER_SUPPLY_PROP_CAPACITY, &v))
+			st->capacity = clamp(v.intval, 0, 100);
+
+		if (!power_supply_get_property(ctx->batt,
+					       POWER_SUPPLY_PROP_STATUS, &v))
+			st->status = v.intval;
+
+		if (!power_supply_get_property(ctx->batt,
+					       POWER_SUPPLY_PROP_TEMP, &v))
+			st->temp = v.intval;
+
+		if (!power_supply_get_property(ctx->batt,
+					       POWER_SUPPLY_PROP_PRESENT, &v))
+			st->present = !!v.intval;
+
+		{
+			int v_uv = 0, i_ua = 0;
+
+			if (!power_supply_get_property(ctx->batt,
+					POWER_SUPPLY_PROP_VOLTAGE_NOW, &v))
+				v_uv = v.intval;
+			if (!power_supply_get_property(ctx->batt,
+					POWER_SUPPLY_PROP_CURRENT_NOW, &v))
+				i_ua = v.intval;
+
+			if (v_uv > 0 && i_ua > 0)
+				st->power_uw = div_u64((u64)v_uv * i_ua,
+						       1000000);
+		}
+	}
+
+	if (ctx->usb) {
+		if (!power_supply_get_property(ctx->usb,
+					       POWER_SUPPLY_PROP_ONLINE, &v))
+			st->online = !!v.intval;
+		else if (!power_supply_get_property(ctx->usb,
+						    POWER_SUPPLY_PROP_PRESENT, &v))
+			st->online = !!v.intval;
+		else
+			st->online = 0;
+	} else {
+		/*
+		 * No charger supply at all: trust the battery status so that
+		 * boards with only a fuel gauge still work.
+		 */
+		st->online = st->status == POWER_SUPPLY_STATUS_CHARGING ||
+			     st->status == POWER_SUPPLY_STATUS_FULL;
+	}
+
+	pcdbg("state: cap=%d status=%d temp=%d present=%d online=%d",
+	      st->capacity, st->status, st->temp, st->present, st->online);
+}
+
+/* ------------------------------------------------------------------ */
+/* power key								*/
+/* ------------------------------------------------------------------ */
+
+static void lpm_boot_work_fn(struct work_struct *work)
+{
+	pclog("power key held for %d ms, booting normally", LPM_BOOT_HOLD_MS);
+	WRITE_ONCE(lpm_boot_requested, true);
+	wake_up(&lpm_wait);
+}
+
+#if IS_ENABLED(CONFIG_INPUT)
+static struct input_handle *lpm_input_handle;
+static bool lpm_input_registered;
+
+static void lpm_input_event(struct input_handle *handle, unsigned int type,
+			    unsigned int code, int value)
+{
+	if (type != EV_KEY || code != KEY_POWER)
+		return;
+
+	pcdbg("power key event: value=%d", value);
+
+	if (value == 1)
+		schedule_delayed_work(&lpm_boot_work,
+				      msecs_to_jiffies(LPM_BOOT_HOLD_MS));
+	else if (value == 0)
+		cancel_delayed_work(&lpm_boot_work);
+}
+
+static int lpm_input_connect(struct input_handler *handler,
+			     struct input_dev *dev,
+			     const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int error;
+
+	if (!test_bit(KEY_POWER, dev->keybit))
+		return -ENODEV;
+
+	/* one power key is enough */
+	if (lpm_input_handle)
+		return -ENODEV;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "offmode_charger";
+
+	error = input_register_handle(handle);
+	if (error) {
+		kfree(handle);
+		return error;
+	}
+
+	error = input_open_device(handle);
+	if (error) {
+		input_unregister_handle(handle);
+		kfree(handle);
+		return error;
+	}
+
+	lpm_input_handle = handle;
+	pcdbg("power key handler attached to \"%s\"", dev->name);
+	return 0;
+}
+
+static void lpm_input_disconnect(struct input_handle *handle)
+{
+	if (handle != lpm_input_handle)
+		return;
+
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	lpm_input_handle = NULL;
+	kfree(handle);
+}
+
+static const struct input_device_id lpm_input_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT,
+		.evbit = { BIT_MASK(EV_KEY) },
+	},
+	{ },
+};
+
+static struct input_handler lpm_input_handler = {
+	.event		= lpm_input_event,
+	.connect	= lpm_input_connect,
+	.disconnect	= lpm_input_disconnect,
+	.name		= "offmode_charger",
+	.id_table	= lpm_input_ids,
+};
+
+static void lpm_input_register(void)
+{
+	lpm_input_registered = !input_register_handler(&lpm_input_handler);
+	if (!lpm_input_registered)
+		pcwarn("cannot register power key handler, hold-to-boot disabled");
+}
+
+static void lpm_input_unregister(void)
+{
+	if (!lpm_input_registered)
+		return;
+
+	if (lpm_input_handle)
+		lpm_input_disconnect(lpm_input_handle);
+
+	input_unregister_handler(&lpm_input_handler);
+	lpm_input_registered = false;
+}
+#else /* !CONFIG_INPUT */
+static void lpm_input_register(void) { }
+static void lpm_input_unregister(void) { }
+#endif /* CONFIG_INPUT */
+
+/* ------------------------------------------------------------------ */
+/* main loop								*/
+/* ------------------------------------------------------------------ */
+
+/* ------------------------------------------------------------------ */
+/* charge session statistics						*/
+/* ------------------------------------------------------------------ */
+
+struct lpm_stats {
+	ktime_t last;
+	u64 ms;
+	u64 energy_nj;
+	u64 last_report_ms;
+	int start_cap;
+	bool active;
+	bool started;
+};
+
+static struct lpm_stats lpm_stat;
+
+static void lpm_stats_sample(struct offmode_charger_state *st)
+{
+	s64 dt;
+
+	if (!lpm_stat.started) {
+		lpm_stat.started = true;
+		lpm_stat.last = ktime_get();
+		lpm_stat.start_cap = st->capacity;
+		lpm_stat.active = st->status == POWER_SUPPLY_STATUS_CHARGING;
+	}
+
+	dt = ktime_ms_delta(ktime_get(), lpm_stat.last);
+	lpm_stat.last = ktime_get();
+	if (dt <= 0 || dt > 5000)
+		dt = 0;
+
+	if (st->status == POWER_SUPPLY_STATUS_CHARGING)
+		lpm_stat.active = true;
+
+	if (lpm_stat.active && dt > 0) {
+		lpm_stat.ms += dt;
+		lpm_stat.energy_nj += (u64)st->power_uw * dt;
+	}
+
+	st->charge_ms = lpm_stat.ms;
+	st->avg_power_uw = lpm_stat.ms ?
+		(u32)div_u64(lpm_stat.energy_nj, lpm_stat.ms) : 0;
+
+	if (lpm_stat.active && lpm_stat.ms - lpm_stat.last_report_ms >= 600000) {
+		lpm_stat.last_report_ms = lpm_stat.ms;
+		pclog("charging: %llu min, %u.%u W avg, %llu.%llu Wh",
+		      div_u64(lpm_stat.ms, 60000),
+		      st->avg_power_uw / 1000000,
+		      (st->avg_power_uw / 100000) % 10,
+		      div_u64(lpm_stat.energy_nj, 3600000000000ULL),
+		      div_u64(lpm_stat.energy_nj, 360000000000ULL) % 10);
+	}
+}
+
+static void lpm_stats_report(const char *why,
+			     const struct offmode_charger_state *st)
+{
+	u32 avg = st->avg_power_uw;
+
+	if (!lpm_stat.ms)
+		return;
+
+	pclog("charge session %s: %llu min, avg %u.%u W, %llu.%llu Wh, %d%% -> %d%%",
+	      why,
+	      div_u64(lpm_stat.ms, 60000),
+	      avg / 1000000, (avg / 100000) % 10,
+	      div_u64(lpm_stat.energy_nj, 3600000000000ULL),
+	      div_u64(lpm_stat.energy_nj, 360000000000ULL) % 10,
+	      lpm_stat.start_cap, st->capacity);
+}
+
+/* ------------------------------------------------------------------ */
+/* charging curve							*/
+/* ------------------------------------------------------------------ */
+
+struct lpm_ctl {
+	struct power_supply *psy;
+	const char *name;
+	int max_ua;
+	int last_ua;
+	bool ready;
+};
+
+static struct lpm_ctl lpm_ctl;
+
+static int lpm_ctl_setup(void)
+{
+	static const char * const names[] = { "main", "battery", "usb" };
+	union power_supply_propval v;
+	struct power_supply *psy;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		psy = power_supply_get_by_name(names[i]);
+		if (!psy)
+			continue;
+
+		if (power_supply_property_is_writeable(psy,
+				POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX) <= 0 ||
+		    power_supply_get_property(psy,
+				POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX, &v) ||
+		    v.intval <= 0) {
+			power_supply_put(psy);
+			continue;
+		}
+
+		lpm_ctl.psy = psy;
+		lpm_ctl.name = names[i];
+		lpm_ctl.max_ua = v.intval;
+		lpm_ctl.last_ua = v.intval;
+		lpm_ctl.ready = true;
+
+		pclog("charge curve on \"%s\": max %d mA, stop at %d%%, pause above %d C",
+		      names[i], v.intval / 1000, charge_limit, LPM_TEMP_LIMIT);
+		return 0;
+	}
+
+	pcwarn("no writable CONSTANT_CHARGE_CURRENT_MAX, charge curve disabled");
+	return -ENODEV;
+}
+
+static void lpm_ctl_apply(const struct offmode_charger_state *st)
+{
+	union power_supply_propval v;
+	int limit = charge_limit;
+	int pct = 100;
+	int target;
+
+	if (!lpm_ctl.ready)
+		return;
+
+	if (limit <= 0 || limit > 100)
+		limit = 100;
+
+	/* thermal derating first, it wins over everything else */
+	if (st->temp != S32_MIN) {
+		if (st->temp >= LPM_TEMP_LIMIT * 10)
+			pct = 0;
+		else if (st->temp >= (LPM_TEMP_LIMIT - LPM_WARM_DELTA) * 10)
+			pct = 50;
+	}
+
+	/* Xiaomi-style curve: full current, then a linear taper */
+	if (pct > 0 && st->capacity >= 0) {
+		if (st->capacity >= LPM_TAPER_END) {
+			pct = min(pct, LPM_TAPER_PCT);
+		} else if (st->capacity > LPM_FAST_UNTIL) {
+			int drop = 100 - LPM_TAPER_PCT;
+			int span = LPM_TAPER_END - LPM_FAST_UNTIL;
+
+			pct = min(pct, 100 - drop *
+				  (st->capacity - LPM_FAST_UNTIL) / span);
+		}
+	}
+
+	if (limit < 100 && st->capacity >= limit)
+		pct = 0;
+
+	target = pct ? lpm_ctl.max_ua * pct / 100 : LPM_MIN_CURRENT_UA;
+	if (target < LPM_MIN_CURRENT_UA)
+		target = LPM_MIN_CURRENT_UA;
+	if (target == lpm_ctl.last_ua)
+		return;
+
+	v.intval = target;
+	if (power_supply_set_property(lpm_ctl.psy,
+			POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX, &v)) {
+		pcdbg("cannot set charge current to %d mA", target / 1000);
+		return;
+	}
+
+	pcdbg("curve: %d -> %d mA (cap %d%%, temp %d C, %d%%)",
+	      lpm_ctl.last_ua / 1000, target / 1000, st->capacity,
+	      st->temp == S32_MIN ? -1 : st->temp / 10, pct);
+
+	lpm_ctl.last_ua = target;
+}
+
+static void lpm_ctl_restore(void)
+{
+	union power_supply_propval v;
+
+	if (!lpm_ctl.ready)
+		return;
+
+	v.intval = lpm_ctl.max_ua;
+	power_supply_set_property(lpm_ctl.psy,
+				  POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+				  &v);
+	power_supply_put(lpm_ctl.psy);
+	lpm_ctl.ready = false;
+}
+
+static void __noreturn lpm_power_off(void)
+{
+	pclog("powering off");
+	kernel_power_off();
+
+	pcwarn("kernel_power_off() returned, no pm_power_off handler?");
+
+	for (;;)
+		msleep(1000);
+}
+
+void offmode_charger_run(void)
+{
+	struct lpm_ctx ctx = { NULL, NULL };
+	struct offmode_charger_state st = { 0 };
+	unsigned long deadline;
+	bool anim = false;
+	bool seen_online = false;
+	bool console_off = false;
+	int off_ticks = 0;
+
+	if (lpm_running)
+		return;
+
+	lpm_running = true;
+	offmode_charger_log_start();
+	pclog("entering kernel off-mode charger UI");
+
+	INIT_DELAYED_WORK(&lpm_boot_work, lpm_boot_work_fn);
+
+	if (lpm_wait_supplies(&ctx) < 0) {
+		pcwarn("no battery power supply, booting normally");
+		goto out;
+	}
+
+	suspend_console();
+	console_off = true;
+
+	if (offmode_charger_display_init() < 0)
+		pcwarn("no usable framebuffer, charger UI runs headless");
+
+	lpm_input_register();
+	lpm_ctl_setup();
+
+	deadline = jiffies + msecs_to_jiffies(LPM_NO_CHARGER_BOOT_MS);
+
+	for (;;) {
+		if (!ctx.usb)
+			ctx.usb = lpm_get_charger_psy();
+
+		lpm_read_state(&ctx, &st);
+		lpm_stats_sample(&st);
+		lpm_ctl_apply(&st);
+
+		if (st.online) {
+			seen_online = true;
+			off_ticks = 0;
+		} else if (seen_online) {
+			off_ticks++;
+		}
+
+		offmode_charger_display_update(&st, anim);
+
+		if (READ_ONCE(lpm_boot_requested))
+			break;
+
+		if (seen_online && off_ticks >= LPM_OFF_TICKS) {
+			pclog("charger offline for %d polls, powering off", off_ticks);
+			lpm_stats_report("ended", &st);
+			lpm_ctl_restore();
+			offmode_charger_display_shutdown();
+			resume_console();
+			lpm_input_unregister();
+			lpm_power_off();
+		}
+
+		if (!seen_online && time_after(jiffies, deadline)) {
+			pcwarn("charger never came online, booting normally");
+			break;
+		}
+
+		wait_event_timeout(lpm_wait, READ_ONCE(lpm_boot_requested),
+				   msecs_to_jiffies(LPM_ANIM_MS));
+		anim = !anim;
+	}
+
+out:
+	cancel_delayed_work_sync(&lpm_boot_work);
+	lpm_stats_report("ended", &st);
+	lpm_ctl_restore();
+	offmode_charger_display_shutdown();
+	if (console_off)
+		resume_console();
+	lpm_input_unregister();
+	lpm_rewrite_cmdline();
+
+	if (ctx.batt)
+		power_supply_put(ctx.batt);
+	if (ctx.usb)
+		power_supply_put(ctx.usb);
+
+	lpm_running = false;
+	pclog("leaving off-mode charger UI");
+	offmode_charger_log_flush();
+}
diff --git a/drivers/power/supply/offmode_charger/offmode_charger_display.c b/drivers/power/supply/offmode_charger/offmode_charger_display.c
new file mode 100644
index 0000000..9a63be8
--- /dev/null
+++ b/drivers/power/supply/offmode_charger/offmode_charger_display.c
@@ -0,0 +1,423 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Framebuffer back end for the kernel off-mode charger UI.
+ *
+ * Only depends on struct fb_info and on the framebuffer memory itself, so it
+ * works with any fbdev provider (drm_fb_helper based msm fbdev, simplefb,
+ * efifb, the legacy FB_MSM driver, ...) and does not need fbcon, a colour
+ * map or the console font code.
+ */
+
+#define pr_fmt(fmt)	"offmode_charger: " fmt
+
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/fb.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/power_supply.h>
+#include <linux/string.h>
+
+#include "offmode_charger_internal.h"
+
+#define LPM_FB_WAIT_MS	15000
+
+extern struct fb_info *registered_fb[];
+
+static struct fb_info *lpm_fb;
+static u32 lpm_w, lpm_h, lpm_stride;
+static u32 lpm_bpp;
+static u32 lpm_black, lpm_white, lpm_green, lpm_yellow, lpm_red, lpm_gray;
+
+/* last painted state, used to avoid repainting the whole panel every frame */
+static int lpm_last_cap = -2;
+static int lpm_last_status = -2;
+static int lpm_last_online = -2;
+static int lpm_last_present = -2;
+
+static u32 lpm_rgb(u8 r, u8 g, u8 b)
+{
+	switch (lpm_bpp) {
+	case 16:
+		return ((u32)(r >> 3) << 11) | ((u32)(g >> 2) << 5) |
+		       (b >> 3);
+	default:
+		return ((u32)r << 16) | ((u32)g << 8) | b;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* primitive drawing							*/
+/* ------------------------------------------------------------------ */
+
+static void lpm_fill(int x, int y, int w, int h, u32 color)
+{
+	u8 *dst;
+	int bytes, row, col;
+
+	if (!lpm_fb || w <= 0 || h <= 0)
+		return;
+
+	if (x < 0) {
+		w += x;
+		x = 0;
+	}
+	if (y < 0) {
+		h += y;
+		y = 0;
+	}
+	if (x + w > (int)lpm_w)
+		w = (int)lpm_w - x;
+	if (y + h > (int)lpm_h)
+		h = (int)lpm_h - y;
+	if (w <= 0 || h <= 0)
+		return;
+
+	bytes = lpm_bpp >> 3;
+	dst = (u8 *)lpm_fb->screen_buffer + (u32)y * lpm_stride +
+	      (u32)x * bytes;
+
+	for (row = 0; row < h; row++) {
+		if (bytes == 4) {
+			u32 *p = (u32 *)dst;
+
+			for (col = 0; col < w; col++)
+				p[col] = color;
+		} else if (bytes == 2) {
+			u16 *p = (u16 *)dst;
+
+			for (col = 0; col < w; col++)
+				p[col] = (u16)color;
+		} else {
+			u8 *p = dst;
+
+			for (col = 0; col < w; col++) {
+				*p++ = color & 0xff;
+				*p++ = (color >> 8) & 0xff;
+				*p++ = (color >> 16) & 0xff;
+			}
+		}
+		dst += lpm_stride;
+	}
+}
+
+static void lpm_glyph(int x, int y, int scale, unsigned char c, u32 fg)
+{
+	const u8 *g = offmode_charger_font_glyph(c);
+	int row, bit;
+
+	if (!g)
+		return;
+
+	for (row = 0; row < 8; row++) {
+		for (bit = 0; bit < 8; bit++) {
+			bool on = g[row] & (0x80 >> bit);
+
+			lpm_fill(x + bit * scale, y + row * scale,
+				 scale, scale, on ? fg : lpm_black);
+		}
+	}
+}
+
+static void lpm_text(const char *s, int scale, int y, u32 fg)
+{
+	int len = strlen(s);
+	int x = ((int)lpm_w - len * 8 * scale) / 2;
+
+	if (x < 0)
+		x = 0;
+
+	for (; *s; s++, x += 8 * scale)
+		lpm_glyph(x, y, scale, *s, fg);
+}
+
+/* ------------------------------------------------------------------ */
+/* layout								*/
+/* ------------------------------------------------------------------ */
+
+struct lpm_layout {
+	int bw;
+	int bh;
+	int brd;
+	int bx;
+	int by;
+	int bottom;
+};
+
+static struct lpm_layout lpm_compute_layout(void)
+{
+	struct lpm_layout l;
+
+	l.bw = (int)(lpm_w * 45 / 100);
+	if (l.bw > (int)(lpm_h * 32 / 100))
+		l.bw = (int)(lpm_h * 32 / 100);
+	l.bw = max(l.bw, 24);
+
+	l.bh = l.bw * 17 / 10;
+	if (l.bh > (int)(lpm_h * 55 / 100)) {
+		l.bh = (int)(lpm_h * 55 / 100);
+		l.bw = l.bh * 10 / 17;
+	}
+
+	l.brd = max(3, l.bw / 45);
+	l.bx = ((int)lpm_w - l.bw) / 2;
+	l.by = (int)(lpm_h * 38 / 100) - l.bh / 2;
+	l.bottom = l.by + l.bh;
+
+	return l;
+}
+
+static void lpm_paint_battery(const struct lpm_layout *l, int cap)
+{
+	int capw, caph, iw, ih, fill;
+	u32 color;
+
+	/* battery terminal */
+	capw = max(8, l->bw / 4);
+	caph = max(4, l->bw / 22);
+	lpm_fill(l->bx + (l->bw - capw) / 2, l->by - caph, capw, caph,
+		 lpm_gray);
+
+	/* battery body */
+	lpm_fill(l->bx, l->by, l->bw, l->brd, lpm_gray);
+	lpm_fill(l->bx, l->by + l->bh - l->brd, l->bw, l->brd, lpm_gray);
+	lpm_fill(l->bx, l->by, l->brd, l->bh, lpm_gray);
+	lpm_fill(l->bx + l->bw - l->brd, l->by, l->brd, l->bh, lpm_gray);
+
+	/* charge level */
+	iw = l->bw - 2 * l->brd;
+	ih = l->bh - 2 * l->brd;
+	if (cap < 0 || iw <= 0 || ih <= 0)
+		return;
+
+	if (cap >= 50)
+		color = lpm_green;
+	else if (cap >= 20)
+		color = lpm_yellow;
+	else
+		color = lpm_red;
+
+	fill = ih * clamp(cap, 0, 100) / 100;
+	lpm_fill(l->bx + l->brd, l->by + l->bh - l->brd - fill, iw, fill,
+		 color);
+}
+
+static int lpm_percent_scale(int bw)
+{
+	int scale = max(1, bw / 32);
+
+	return min(scale, max(1, (int)lpm_w / (4 * 8)));
+}
+
+static void lpm_draw_percent(const struct offmode_charger_state *st, int bw, int y)
+{
+	char buf[8];
+
+	if (st->capacity < 0)
+		return;
+
+	snprintf(buf, sizeof(buf), "%d%%", clamp(st->capacity, 0, 100));
+	lpm_text(buf, lpm_percent_scale(bw), y, lpm_white);
+}
+
+static const char *lpm_status_text(const struct offmode_charger_state *st,
+				   bool anim, u32 *color)
+{
+	*color = lpm_white;
+
+	if (st->temp != S32_MIN && st->temp >= 450) {
+		*color = lpm_red;
+		return "TEMP HIGH";
+	}
+
+	if (st->present == 0) {
+		*color = lpm_red;
+		return "NO BATTERY";
+	}
+
+	if (!st->online) {
+		*color = lpm_yellow;
+		return "NOT CHARGING";
+	}
+
+	if (st->status == POWER_SUPPLY_STATUS_FULL || st->capacity >= 100) {
+		*color = lpm_green;
+		return "FULL";
+	}
+
+	if (st->status == POWER_SUPPLY_STATUS_CHARGING)
+		return anim ? "CHARGING..." : "CHARGING.";
+
+	return "CONNECTED";
+}
+
+static int lpm_draw_status(const struct offmode_charger_state *st, int y, bool anim)
+{
+	const char *s;
+	u32 color;
+	int len, scale;
+
+	s = lpm_status_text(st, anim, &color);
+	len = strlen(s);
+
+	scale = max(1, (int)lpm_w / (len * 8 * 2));
+	scale = min(scale, 10);
+	if (len * 8 * scale > (int)lpm_w)
+		scale = 1;
+
+	lpm_text(s, scale, y, color);
+
+	return 8 * scale + 10;
+}
+
+/* "12m34s 18.4W" under the status line, once a charge session is running */
+static void lpm_draw_stats(const struct offmode_charger_state *st, int y)
+{
+	char buf[40];
+	u32 p = st->avg_power_uw;
+	u64 ms = st->charge_ms;
+	unsigned int min, sec;
+	int len, scale;
+
+	if (!ms)
+		return;
+
+	min = div_u64(ms, 60000);
+	sec = div_u64(ms % 60000, 1000);
+
+	if (min >= 60)
+		snprintf(buf, sizeof(buf), "%uh%02um", min / 60, min % 60);
+	else
+		snprintf(buf, sizeof(buf), "%um%02us", min, sec);
+
+	if (p) {
+		len = strlen(buf);
+		snprintf(buf + len, sizeof(buf) - len, "  %u.%uW",
+			 p / 1000000, (p / 100000) % 10);
+	}
+
+	len = strlen(buf);
+	scale = max(1, (int)lpm_w / (len * 8 * 3));
+	scale = min(scale, 8);
+	if (len * 8 * scale > (int)lpm_w)
+		scale = 1;
+
+	lpm_text(buf, scale, y, lpm_gray);
+}
+
+/* ------------------------------------------------------------------ */
+/* public interface							*/
+/* ------------------------------------------------------------------ */
+
+int offmode_charger_display_init(void)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(LPM_FB_WAIT_MS);
+
+	for (;;) {
+		struct fb_info *best = NULL;
+		u32 best_area = 0;
+		int i;
+
+		for (i = 0; i < FB_MAX; i++) {
+			struct fb_info *info = registered_fb[i];
+			u32 area;
+
+			if (!info || !info->screen_buffer)
+				continue;
+			if (info->state != FBINFO_STATE_RUNNING)
+				continue;
+			if (!info->var.xres || !info->var.yres)
+				continue;
+			if (info->var.bits_per_pixel != 16 &&
+			    info->var.bits_per_pixel != 24 &&
+			    info->var.bits_per_pixel != 32)
+				continue;
+
+			area = info->var.xres * info->var.yres;
+			if (area > best_area) {
+				best = info;
+				best_area = area;
+			}
+		}
+
+		if (best) {
+			lpm_fb = best;
+			break;
+		}
+
+		if (time_after(jiffies, timeout))
+			return -ENODEV;
+
+		msleep(100);
+	}
+
+	lpm_w = lpm_fb->var.xres;
+	lpm_h = lpm_fb->var.yres;
+	lpm_bpp = lpm_fb->var.bits_per_pixel;
+	lpm_stride = lpm_fb->fix.line_length;
+	if (!lpm_stride)
+		lpm_stride = lpm_w * lpm_bpp / 8;
+
+	lpm_black  = lpm_rgb(0x00, 0x00, 0x00);
+	lpm_white  = lpm_rgb(0xff, 0xff, 0xff);
+	lpm_green  = lpm_rgb(0x00, 0xd4, 0x6a);
+	lpm_yellow = lpm_rgb(0xff, 0xc1, 0x07);
+	lpm_red    = lpm_rgb(0xff, 0x3b, 0x30);
+	lpm_gray   = lpm_rgb(0x6e, 0x6e, 0x6e);
+
+	pclog("framebuffer %ux%u %ubpp, stride %u",
+	      lpm_w, lpm_h, lpm_bpp, lpm_stride);
+
+	return 0;
+}
+
+void offmode_charger_display_update(const struct offmode_charger_state *st, bool anim)
+{
+	struct lpm_layout lay;
+	bool full;
+	int pscale, y, band;
+
+	if (!lpm_fb)
+		return;
+
+	full = st->capacity != lpm_last_cap ||
+	       st->status != lpm_last_status ||
+	       st->online != lpm_last_online ||
+	       st->present != lpm_last_present;
+
+	lay = lpm_compute_layout();
+	pscale = lpm_percent_scale(lay.bw);
+	y = lay.bottom + lay.bw / 10;
+
+	if (full) {
+		pcdbg("redraw: cap=%d status=%d online=%d present=%d",
+		      st->capacity, st->status, st->online, st->present);
+		lpm_fill(0, 0, (int)lpm_w, (int)lpm_h, lpm_black);
+		lpm_paint_battery(&lay, st->capacity);
+
+		lpm_last_cap = st->capacity;
+		lpm_last_status = st->status;
+		lpm_last_online = st->online;
+		lpm_last_present = st->present;
+	} else {
+		/* only the text block changes between animation frames */
+		band = 8 * pscale + lay.bw / 20 + 8 * 10 + 8 * 8 + 60;
+		lpm_fill(0, y - 8, (int)lpm_w, band, lpm_black);
+	}
+
+	lpm_draw_percent(st, lay.bw, y);
+	y += 8 * pscale + lay.bw / 20;
+	y += lpm_draw_status(st, y, anim);
+	lpm_draw_stats(st, y);
+}
+
+void offmode_charger_display_shutdown(void)
+{
+	if (!lpm_fb)
+		return;
+
+	lpm_fill(0, 0, (int)lpm_w, (int)lpm_h, lpm_black);
+}
diff --git a/drivers/power/supply/offmode_charger/offmode_charger_font.c b/drivers/power/supply/offmode_charger/offmode_charger_font.c
new file mode 100644
index 0000000..2ff3f22
--- /dev/null
+++ b/drivers/power/supply/offmode_charger/offmode_charger_font.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 8x8 bitmap font for glyphs 0x20..0x7e.
+ *
+ * Generated from lib/fonts/font_8x8.c (VGA 8x8 console font) of this
+ * kernel, so the charger UI does not depend on CONFIG_FONTS or on a
+ * framebuffer console being enabled.
+ */
+
+#include <linux/types.h>
+#include "offmode_charger_internal.h"
+
+#define LPM_FONT_FIRST	0x20
+#define LPM_FONT_LAST	0x7e
+
+static const u8 lpm_font_data[LPM_FONT_LAST - LPM_FONT_FIRST + 1][8] = {
+	{ 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 },	/* U+0020 */
